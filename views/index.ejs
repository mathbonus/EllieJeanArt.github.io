<%- include('partials/head') %>
<%- include('partials/header') %>

<main>
  <section class="hero">
    <div class="profile-stamp">
      <img src="<%= board.profileImage %>" alt="Profile portrait for <%= board.owner %>" width="100" height="100">
    </div>
    <p class="kicker">a portfolio, gathered in one place</p>
    <h1 class="hand">my memory closet.<br><em>art, collected by section.</em></h1>
    <p class="hero-note">Choose a collection to explore all <%= totalPins %> pins on Pinterest.</p>
  </section>

  <section id="memory-board" class="pinboard" aria-labelledby="pinboard-title">
    <div class="pinboard-heading">
      <div>
        <p class="kicker">a little shuffle of the things I love</p>
        <h2 id="pinboard-title" class="hand">the picture rail</h2>
        <p id="pinboard-status" class="pinboard-status" aria-live="polite"><%= sections[0].pins[0].caption %> · <%= sections[0].title %></p>
      </div>
      <div class="pinboard-controls">
        <button id="previous-pin" class="btn" type="button" aria-label="Previous photo">←</button>
        <button id="shuffle-board" class="btn" type="button">shuffle</button>
        <button id="pause-board" class="btn" type="button" aria-pressed="false">pause</button>
        <button id="next-pin" class="btn" type="button" aria-label="Next photo">→</button>
      </div>
    </div>
    <div id="pin-carousel" class="pin-carousel" aria-label="Pinterest photos; the centered image is in focus">
      <% let pinIndex = 0; %>
      <% sections.forEach((section) => { %>
        <% section.pins.forEach((pin) => { %>
          <a class="pin-slide<%= pinIndex === 0 ? ' is-active' : '' %>" href="<%= section.url %>" target="_blank" rel="noopener noreferrer"
             <%= pinIndex === 0 ? 'aria-current="true"' : '' %>
             data-title="<%= pin.caption %>" data-section="<%= section.title %>">
            <img src="<%= pin.image %>" alt="<%= pin.alt %>" loading="lazy">
            <span class="pin-caption">
              <span class="pin-caption-title"><%= pin.caption %></span>
              <span class="pin-caption-section"><%= section.title %></span>
            </span>
          </a>
          <% pinIndex += 1; %>
        <% }) %>
      <% }) %>
    </div>
    <p class="pinboard-note">The picture rail shuffles every 10 seconds; only the center photo stays sharp. <a id="pinboard-link" href="<%= sections[0].url %>" target="_blank" rel="noopener noreferrer">Open this collection on Pinterest ↗</a></p>
  </section>

  <section id="sections" class="sections">
    <h2 class="hand">explore the collections</h2>
    <div class="section-grid">
      <% sections.forEach((section, index) => { %>
        <a class="section-card section-card--<%= section.id %>" href="<%= section.url %>" target="_blank" rel="noopener noreferrer">
          <div class="section-art" aria-hidden="true">
            <span class="section-index">0<%= index + 1 %></span>
            <span class="section-count"><%= section.count %> pins</span>
          </div>
          <div class="section-copy">
            <h3 class="hand"><%= section.title %></h3>
            <p><%= section.description %></p>
            <span class="section-link">explore section ↗</span>
          </div>
        </a>
      <% }) %>
    </div>
  </section>
</main>

<%- include('partials/footer') %>
